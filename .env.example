DATABASE_URL="postgres://sistem_ujian:sistem_ujian@localhost:55432/sistem_ujian"
BETTER_AUTH_SECRET="change-this-to-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Evaluation API (Google Gemini / Groq)
GEMINI_API_KEY=
GROQ_API_KEY=

# Maintenance: use the same strong secret in the app and scheduler/worker.
CRON_SECRET=
# Base URL used by npm run worker (defaults to BETTER_AUTH_URL).
MAINTENANCE_BASE_URL="http://localhost:3000"
# Maximum PostgreSQL connections per app instance.
DB_POOL_MAX=5
